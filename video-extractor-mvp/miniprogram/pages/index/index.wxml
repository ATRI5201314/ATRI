<view class="page">
  <view class="ad-slot">
    <ad wx:if="{{bannerAdUnitId}}" unit-id="{{bannerAdUnitId}}"></ad>
    <view wx:else class="ad-placeholder">广告位 · 开通流量主后填入 bannerAdUnitId</view>
  </view>

  <view class="card">
    <textarea
      class="input"
      value="{{inputText}}"
      bindinput="onInput"
      placeholder="长按粘贴视频链接，例如：7.69 p@D... https://v.douyin.com/xxx/"
      maxlength="-1"
      auto-height
    ></textarea>

    <view class="row">
      <button class="btn ghost" bindtap="onPaste">粘贴内容</button>
      <button class="btn ghost" bindtap="onClear">清空内容</button>
    </view>

    <view class="tip">视频版权归平台及作者所有，本工具仅用于个人学习与本地保存，不存储任何内容。</view>

    <button class="btn primary block" loading="{{loading}}" bindtap="onStart">开始获取</button>
    <view class="demo-link" bindtap="onDemo">没有链接？点这里体验示例</view>
  </view>

  <view class="card" wx:if="{{result}}">
    <view class="platform">{{result.platform}}</view>

    <view class="tabs">
      <view class="tab {{activeTab === 'video' ? 'active' : ''}}" data-tab="video" bindtap="onTab">视频</view>
      <view class="tab {{activeTab === 'images' ? 'active' : ''}}" data-tab="images" bindtap="onTab">图片</view>
      <view class="tab {{activeTab === 'title' ? 'active' : ''}}" data-tab="title" bindtap="onTab">标题</view>
    </view>

    <view class="unlock-bar" wx:if="{{rewardedAdUnitId}}">
      <view class="unlock-info">
        <text class="unlock-title">{{adFree ? '免广告下载已开启' : '看广告 · 解锁 24 小时免广告'}}</text>
        <text class="unlock-sub">{{adFree ? adFreeText : '完整观看一段视频广告后生效'}}</text>
      </view>
      <text class="unlock-tag {{adFree ? 'on' : ''}}">{{adFree ? '已解锁' : '未解锁'}}</text>
    </view>

    <block wx:if="{{activeTab === 'video'}}">
      <video
        wx:if="{{result.videoUrl}}"
        class="video"
        src="{{result.videoUrl}}"
        poster="{{result.cover}}"
        controls
        object-fit="contain"
      ></video>
      <view wx:else class="empty">该作品没有视频，去「图片」页看看</view>

      <view class="metas">
        <view class="meta">清晰度：{{result.quality}}</view>
        <view class="meta">体积：{{result.size}}</view>
        <view class="meta">源：{{result.sources.length}}</view>
      </view>

      <view class="row">
        <button class="btn ghost" bindtap="onCopy">复制链接</button>
        <button class="btn primary" bindtap="onSaveVideo">保存视频</button>
      </view>
    </block>

    <block wx:elif="{{activeTab === 'images'}}">
      <view class="grid" wx:if="{{result.images.length}}">
        <image
          wx:for="{{result.images}}"
          wx:key="*this"
          class="grid-item"
          src="{{item}}"
          mode="aspectFill"
          data-url="{{item}}"
          bindtap="onPreview"
        ></image>
      </view>
      <view wx:else class="empty">该作品没有图集</view>

      <button wx:if="{{result.images.length}}" class="btn primary block" bindtap="onSaveImages">保存全部图片</button>
    </block>

    <block wx:else>
      <view class="title-text">{{result.title}}</view>
      <button class="btn ghost block" bindtap="onCopyTitle">复制标题</button>
    </block>
  </view>
</view>
