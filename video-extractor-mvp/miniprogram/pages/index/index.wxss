.page {
  padding: 24rpx;
}

.ad-slot {
  background: #ffffff;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  overflow: hidden;
}

.ad-placeholder {
  height: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #edf1ef;
  color: #9aa0a6;
  font-size: 24rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.input {
  width: 100%;
  min-height: 200rpx;
  background: #f6f8f7;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  line-height: 1.5;
}

.row {
  display: flex;
  justify-content: space-between;
  margin-top: 20rpx;
}

.row .btn {
  width: 48%;
}

.btn {
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  font-size: 28rpx;
  font-weight: 500;
  padding: 0;
  margin: 0;
}

.btn.primary {
  background: #3ebd6a;
  color: #ffffff;
}

.btn.ghost {
  background: #eaf6ee;
  color: #2f7a4d;
}

.btn.block {
  width: 100%;
  margin-top: 20rpx;
}

.tip {
  margin: 16rpx 0 4rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #9aa0a6;
}

.demo-link {
  margin-top: 20rpx;
  text-align: center;
  font-size: 24rpx;
  color: #3ebd6a;
}

.platform {
  display: inline-block;
  padding: 4rpx 16rpx;
  margin-bottom: 16rpx;
  border-radius: 999rpx;
  background: #eaf6ee;
  color: #2f7a4d;
  font-size: 22rpx;
}

.tabs {
  display: flex;
  margin-bottom: 20rpx;
  border-bottom: 1rpx solid #eef1ef;
}

.tab {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #6b7280;
  position: relative;
}

.tab.active {
  color: #3ebd6a;
  font-weight: 600;
}

.tab.active::after {
  content: "";
  position: absolute;
  left: 25%;
  right: 25%;
  bottom: -1rpx;
  height: 4rpx;
  border-radius: 2rpx;
  background: #3ebd6a;
}

.video {
  width: 100%;
  height: 600rpx;
  background: #000000;
  border-radius: 16rpx;
}

.metas {
  display: flex;
  justify-content: space-between;
  margin: 20rpx 0;
}

.meta {
  width: 31%;
  padding: 12rpx 0;
  text-align: center;
  font-size: 24rpx;
  color: #6b7280;
  background: #f6f8f7;
  border-radius: 12rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.grid-item {
  width: 31.5%;
  height: 300rpx;
  margin-bottom: 16rpx;
  border-radius: 12rpx;
  background: #f0f2f1;
}

.empty {
  padding: 60rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #9aa0a6;
}

.title-text {
  margin-bottom: 20rpx;
  font-size: 28rpx;
  line-height: 1.6;
  color: #1a1a1a;
}

.unlock-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  margin-bottom: 20rpx;
  background: #f7f9f8;
  border-radius: 16rpx;
}

.unlock-info {
  flex: 1;
  min-width: 0;
}

.unlock-title {
  display: block;
  font-size: 26rpx;
  font-weight: 500;
  color: #1a1a1a;
}

.unlock-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9aa0a6;
}

.unlock-tag {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  background: #edf1ef;
  color: #6b7280;
  font-size: 22rpx;
}

.unlock-tag.on {
  background: #3ebd6a;
  color: #ffffff;
}
